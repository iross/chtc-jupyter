# jupyter.sub
# Event log; must not share a name with the runtime jupyter.log transferred back on exit
log = condor.log

universe = docker
docker_image = iaross/jupyter_2026-07-10-1
# Share the host network namespace so the ssh port-forward chain can reach
# Jupyter on localhost (bridge networking hides the container's 127.0.0.1)
docker_network_type = host

transfer_executable = false
transfer_input_files = launch_jupyter.sh
when_to_transfer_output = ON_EXIT_OR_EVICT
# See https://htcondor.readthedocs.io/en/main/faq/users/transfer-files-on-rm.html
My.SpoolOnEvict = false

executable = /bin/sleep
arguments = 168h
output = jupyter.out
stream_output = true
error = jupyter.err
stream_error = true

# Adjust resources as desired
request_cpus = 1
request_memory = 16GB
request_disk = 16GB
# Uncomment to land on DGX Sparks
requirements = Arch == "aarch64"

## If using GPUs:
+GPUJobLength = "long"
request_gpus = 1

## adjust as desired:
#gpus_minimum_memory = 10GB
#gpus_minimum_capability = 5.0
#gpus_maximum_capability = 8.9
